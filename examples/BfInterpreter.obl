module BFInterpreter

import In, Out;

fn export Run(code: char[]) -> void
var {
    tape: byte[30000];
    head, pc, codeLen, bracketCount, i: i64;
    ch: char;
}
{
    codeLen = len(code);
    head = 0;
    pc = 0;

    for (i = 0, 30000-1) {
        tape[i] = 0;
    }

    while pc < codeLen {
        ch = code[pc];

        switch ch {
            case ">":
                head = head + 1;

            case "<":
                head = head - 1;

            case "+":
                tape[head] = tape[head] + 1;

            case "-":
                tape[head] = tape[head] - 1;

            case ".":
                Out.Char(chr(tape[head]));

            case ",":
                tape[head] = In.Byte();

            case "[":
                if tape[head] == 0 {
                    bracketCount = 1;
                    while bracketCount > 0 {
                        pc = pc + 1;
                        if code[pc] == "[" {
                            bracketCount = bracketCount + 1;
                        } else if code[pc] == "]" {
                            bracketCount = bracketCount - 1;
                        }
                    }
                }

            case "]":
                if tape[head] != 0 {
                    bracketCount = 1;
                    while bracketCount > 0 {
                        pc = pc - 1;
                        if code[pc] == "]" {
                            bracketCount = bracketCount + 1;
                        } else if code[pc] == "[" {
                            bracketCount = bracketCount - 1;
                        }
                    }
                }
        }

        pc = pc + 1;
    }
}

fn init() -> void
var {
    helloWorldBF: char[120];
}
{
    helloWorldBF = "++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+.>++.";
    Run(helloWorldBF); // компиляция займет время
}
