module ArrayTest

import Out;

var arr: i64[10];

fn Fill() -> void
var i: i64;
{
    i = 0;
    while i < 10 {
        arr[i] = i * i + 1;
        i = i + 1;
    }
}

fn Sum(a: i64[], last: i64) -> i64
var {
    i: i64;
    s: i64;
}
{
    s = 0;
    for (i = 0, last, 1) {
        s = s + a[i];
    }
    return s;
}

fn export Run() -> i64
var {
    total: i64;
}
{
    Fill();
    total = Sum(arr, 9);
    Out.WriteInt(total);
    Out.WriteLn();
    Out.WriteInt(arr[0]);
    Out.WriteLn();
    Out.WriteInt(arr[9]);
    Out.WriteLn();
    return total;
}

fn init() -> void
{
    Run();
}
