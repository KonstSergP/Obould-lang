module OutTest

import Out;

fn export Run() -> i64
var {
    ch: char;
    s: char[6];
    t: i64;
}
{
    ch = "A";
    Out.Char(ch);
    Out.Space();
    Out.String("Hello");
    Out.Space();
    Out.StringLen("Hello", 2);
    Out.Ln();

    t = 42;
    Out.Int(t);
    Out.Space();
    Out.IntWidth(t, 5);
    Out.Space();
    Out.Hex(255, 4);
    Out.Space();
    Out.Byte(255);
    Out.Space();
    Out.Bool(true);
    Out.Space();
    Out.Bool(false);
    Out.Space();
    Out.Real(3.14159, 2);
    Out.Ln();

    s = "Hello";
    Out.String(s);
    Out.Ln();

    return 0;
}

fn init() -> void
{
    Run();
}
