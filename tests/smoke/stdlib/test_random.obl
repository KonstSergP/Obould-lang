module RandomTest

import Out, Random;

fn export Run() -> i64
var {
    a: i64;
    b: i64;
    c: i64;
    d: i64;
}
{
    Random.Seed(123456789);
    a = Random.Next();
    b = Random.Next();
    c = Random.NextInt(10);
    d = Random.NextInt(10);

    Out.Int(a);
    Out.Ln();
    Out.Int(b);
    Out.Ln();
    Out.Int(c);
    Out.Ln();
    Out.Int(d);
    Out.Ln();
    Out.Bool(Random.NextBool());
    Out.Ln();
    Out.Real(Random.NextReal(), 6);
    Out.Ln();

    return 0;
}

fn init() -> void
{
    Run();
}
