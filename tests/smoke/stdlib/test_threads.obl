module TestThreads

import Threads, Out;

var {
    Result1, Result2: i64;
}

fn Worker1() -> void
var i: i64;
{

    Result1 = 0;
    for (i = 0, 1000000) {
        Result1 = Result1 + i;
    }
}

fn Worker2() -> void
var i: i64;
{

    Result2 = 0;
    for (i = 0, 1000000) {
        Result2 = Result2 + (i * 2);
    }
}

fn init() -> void
var {
    t1, t2: Threads.Thread;
}
{
    t1 = Threads.Start(Worker1);
    t2 = Threads.Start(Worker2);

    Threads.Join(t1);
    Threads.Join(t2);

    Out.Int(Result1); Out.Ln();
    Out.Int(Result2); Out.Ln();
}
