module InputDemo

import In, Out;

fn init() -> void
var {
    s: char[32];
    n: i64;
    r: f64;
    c: char;
    len: i64;
}
{
    Out.String("Input order: <int> <real> <char> <word> <line>");
    Out.Ln();

    Out.String("Int: ");
    n = In.Int();
    Out.Int(n);
    Out.String(" Done=");
    Out.Bool(In.Done);
    Out.String(" Truncated=");
    Out.Bool(In.Truncated);
    Out.Ln();

    Out.String("Real: ");
    r = In.Real();
    Out.Real(r, 2);
    Out.String(" Done=");
    Out.Bool(In.Done);
    Out.String(" Truncated=");
    Out.Bool(In.Truncated);
    Out.Ln();

    Out.String("Char: ");
    c = In.Char();
    Out.Char(c);
    Out.String(" Done=");
    Out.Bool(In.Done);
    Out.String(" Truncated=");
    Out.Bool(In.Truncated);
    Out.Ln();

    Out.String("String: ");
    len = In.String(s);
    Out.String(s);
    Out.String(" len=");
    Out.Int(len);
    Out.String(" Done=");
    Out.Bool(In.Done);
    Out.String(" Truncated=");
    Out.Bool(In.Truncated);
    Out.Ln();

    Out.String("Line: ");
    len = In.Line(s);
    Out.String(s);
    Out.String(" len=");
    Out.Int(len);
    Out.String(" Done=");
    Out.Bool(In.Done);
    Out.String(" Truncated=");
    Out.Bool(In.Truncated);
    Out.Ln();
}
