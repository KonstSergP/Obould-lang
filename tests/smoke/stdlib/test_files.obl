module FilesTest

import Files, Out;

fn export Run() -> i64
var {
    f: Files.File;
    r: Files.FileRider;
    w: Files.FileRider;
    b: byte;
    i: i64;
    x: f64;
    s: char[6];
    t: char[16];
    ok: bool;
    status: i64;
}
{
    s = "Hello";
    b = 65;
    i = 123456789;
    x = 3.5;
    ok = false;
    status = 0;

    f = Files.Open("tests/smoke/files_rw.bin", "wb");
    if f == nil {
        Out.String("Files: open(write) failed");
        Out.Ln();
        status = 1;
    } else {
        Files.Set(w, f, 0);
        Files.WriteByte(w, b);
        Files.WriteInt64(w, i);
        Files.WriteReal64(w, x);
        Files.WriteString(w, s);
        Files.Close(f);
    }

    b = 0;
    i = 0;
    x = 0.0;
    t = "";

    if status == 0 {
        f = Files.Open("tests/smoke/files_rw.bin", "rb");
        if f == nil {
            Out.String("Files: open(read) failed");
            Out.Ln();
            status = 1;
        } else {
            Files.Set(r, f, 0);
            Files.ReadByte(r, b);
            Files.ReadInt64(r, i);
            Files.ReadReal64(r, x);
            Files.ReadString(r, t);
            Files.Close(f);

    ok = (b == 65) && (i == 123456789) && (x == 3.5) &&
        (t[0] == "H") && (t[1] == "e") && (t[2] == "l") &&
        (t[3] == "l") && (t[4] == "o");
        }
    }

    Out.String("Files RW:");
    Out.Ln();
    Out.String("  byte=");
    Out.Byte(b);
    Out.String(" int64=");
    Out.Int(i);
    Out.String(" real=");
    Out.Real(x, 2);
    Out.String(" str=");
    Out.String(t);
    Out.Ln();
    Out.String("  res=");
    Out.Byte(r.res);
    Out.String(" ok=");
    Out.Bool(ok);
    Out.Ln();

    return status;
}

fn init() -> void
{
    Run();
}
