module GcTest

import Out;

type {
    Node: struct {
        value: i64;
        next: *Node;
    };
}

fn Run() -> i64
var {
    i: i64;
    p: *Node;
    sum: i64;
    keep: *Node;
}
{
    i = 0;
    sum = 0;
    while i < 20000 {
        new(p);
        if i mod 5000 == 0 {
            keep = p;
        }
        p.value = i;
        p.next = nil;
        sum = sum + (i mod 7);
        i = i + 1;
    }
    Out.WriteInt(keep.value);
    Out.WriteLn();
    Out.WriteInt(sum);
    Out.WriteLn();
    return sum;
}

fn init() -> void
{
    Run();
}
