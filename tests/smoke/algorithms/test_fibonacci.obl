module Test

import Out;

fn export Run() -> i64
var {
    i: i64;
    a: i64;
    b: i64;
    t: i64;
}
{
    a = 0;
    b = 1;
    i = 0;

    while i < 100 {
        if (i < 15) {
            Out.WriteInt(a);
            Out.WriteLn();
        }
        t = a + b;
        a = b;
        b = t;
        i = i + 1;
    }

    return a;
}

fn init() -> void
{
    Run();
}
