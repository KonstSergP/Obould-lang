// ============================================================================
// Comprehensive Obould Language Test File
// Tests all language constructs and default types
// ============================================================================

module ComprehensiveTest
import Math, IO;

// ============================================================================
// Constants - различные типы констант
// ============================================================================
const {
    // Integer constants
    MAX_SIZE = 100;
    MIN_VALUE = -50;
    HEX_VALUE = 0xFF;

    // Float constants
    PI = 3.14159;
    E = 2.71828;
    EPSILON = 1.0E-10;
    BIG_NUMBER = 1.5E+20;

    // Boolean constants
    DEBUG_MODE = true;
    RELEASE_MODE = false;

    // String constant
    GREETING = "Hello, Obould!";
    ESCAPED_STRING = "Line1\nLine2\tTabbed\"Quoted\"";
}

// ============================================================================
// Type declarations - все виды типов
// ============================================================================
type {
    // Simple type alias
    Integer: i64;
    Real: f64;
    Flag: bool;
    Character: char;
    Byte: byte;

    // Array types
    IntArray: i64[10];
    Matrix: f64[10][10];
    CharBuffer: char[256];

    // Struct type - базовая запись
    Point2D: struct {
        x, y: f64;
    };

    // Struct for pointer tests
    IntBox: struct {
        value: i64;
    };

    // Struct with inheritance - расширение записи
    Point3D: struct (Point2D) {
        z: f64;
    };

    // Complex struct
    Rectangle: struct {
        topLeft: Point2D;
        width, height: f64;
        visible: bool;
    };

    // Pointer types
    PointPtr: *Point2D;
    IntBoxPtr: *IntBox;

    // Procedure types
    UnaryOp: (x: i64) -> i64;
    BinaryOp: (x, y: i64) -> i64;
    Comparator: (a, b: f64) -> bool;
    VoidProc: () -> void;

    // Nested struct
    TreeNode: struct {
        value: i64;
        left: *TreeNode;
        right: *TreeNode;
    };

    // Struct with array field
    Polygon: struct {
        vertices: Point2D[100];
        numVertices: i64;
    };
}

// ============================================================================
// Global variables - все базовые типы
// ============================================================================
var {
    // Primitive types
    globalInt: i64;
    globalFloat: f64;
    globalBool: bool;
    globalChar: char;
    globalByte: byte;

    // Arrays
    numbers: i64[100];
    matrix: f64[10][10];
    flags: bool[8];
    message: CharBuffer;

    // Struct instances
    origin: Point2D;
    camera: Point3D;
    bounds: Rectangle;

    // Pointers
    ptr: IntBoxPtr;
    nodePtr: *TreeNode;
}

// ============================================================================
// Procedures - различные сигнатуры и конструкции
// ============================================================================

// Simple procedure with no parameters
fn export Init() -> void
{
    globalInt = 0;
    globalFloat = 0.0;
    globalBool = false;
    globalChar = "A";
    message = "Hello";
    ptr = nil;
    nodePtr = nil;
}

// Procedure with value parameters
fn export Add(a, b: i64) -> i64
var result: i64;
{
    result = a + b;
    return result;
}

// Procedure with reference parameter (var parameter)
fn export Swap(a, b: &i64) -> void
var temp: i64;
{
    temp = a;
    a = b;
    b = temp;
}

// Procedure with mixed parameters
fn export Calculate(x, y: f64, scale: &f64) -> f64
var result: f64;
{
    result = (x + y) * scale;
    scale = scale + 1.0;
    return result;
}

// Procedure with array parameter (open array)
fn export SumArray(arr: i64[], size: i64) -> i64
var {
    sum: i64;
    i: i64;
}
{
    sum = 0;
    for (i = 0, size, 1) {
        sum = sum + arr[i];
    }
    return sum;
}

// Procedure with struct parameter
fn export Distance(p1, p2: Point2D) -> f64
var {
    dx, dy: f64;
}
{
    dx = p2.x - p1.x;
    dy = p2.y - p1.y;
    return dx * dx + dy * dy;
}

// Procedure demonstrating all statement types
fn export TestStatements() -> void
var {
    i, j, k: i64;
    condition: bool;
    arr: i64[10];
}
{
    // ========================================
    // Assignment statements
    // ========================================
    i = 0;
    j = 10;
    k = i + j * 2;
    condition = true;
    arr[0] = 100;

    // ========================================
    // If statement - simple
    // ========================================
    if condition {
        i = 1;
    }

    // ========================================
    // If-else statement
    // ========================================
    if i > 0 {
        j = i;
    } else {
        j = 0 - i;
    }

    // ========================================
    // Nested if-else
    // ========================================
    if i < 0 {
        k = 0 - 1;
    } else if i == 0 {
        k = 0;
    } else {
        k = 1;
    }

    // ========================================
    // While loop
    // ========================================
    i = 0;
    while i < 10 {
        arr[i] = i * i;
        i = i + 1;
    }

    // ========================================
    // While with elif (multiple conditions)
    // ========================================
    i = 0;
    j = 0;
    while i < 10 {
        i = i + 1;
    } elif j < 5 {
        j = j + 1;
    }

    // ========================================
    // Do-while loop
    // ========================================
    i = 0;
    do {
        i = i + 1;
    } while i < 10;

    // ========================================
    // For loop - basic
    // ========================================
    for (i = 0, 10, 1) {
        arr[i] = i;
    }

    // ========================================
    // For loop - with step
    // ========================================
    for (i = 0, 100, 10) {
        j = i div 10;
    }

    // ========================================
    // Switch statement - integer cases
    // ========================================
    switch k {
        case 0:
            i = 0;
        case 1:
            i = 1;
        case 2, 3, 4:
            i = 2;
        case 5..10:
            i = 3;
    }

    // ========================================
    // Procedure calls
    // ========================================
    Init();
    k = Add(i, j);
    Swap(i, j);
}

// Procedure demonstrating all expression types
fn export TestExpressions() -> void
var {
    a, b, c: i64;
    x, y, z: f64;
    p, q: bool;
    arr: i64[10];
    pt: Point2D;
}
{
    // ========================================
    // Arithmetic expressions
    // ========================================
    a = 10;
    b = 3;

    c = a + b;          // Addition
    c = a - b;          // Subtraction
    c = a * b;          // Multiplication
    c = a div b;        // Integer division
    c = a mod b;        // Modulo

    x = 10.5;
    y = 3.2;
    z = x / y;          // Float division

    // ========================================
    // Unary expressions
    // ========================================
    c = -a;             // Negation
    c = +b;             // Unary plus
    p = !q;             // Logical not

    // ========================================
    // Comparison expressions
    // ========================================
    p = a == b;         // Equal
    p = a != b;         // Not equal
    p = a < b;          // Less than
    p = a <= b;         // Less or equal
    p = a > b;          // Greater than
    p = a >= b;         // Greater or equal

    // ========================================
    // Logical expressions
    // ========================================
    p = true && false;  // Logical AND
    p = true || false;  // Logical OR
    p = nodePtr == nil;
    // Note: In Obould, && and || have unusual precedence
    // && is multiplicative, || is additive, both HIGHER than comparisons
    // So we need parentheses for compound conditions

    // ========================================
    // Complex expressions with precedence
    // ========================================
    c = a + b * c;                      // * before +
    c = (a + b) * c;                    // Parentheses
    c = a + b * c - a div b mod c;      // Mixed

    // ========================================
    // Array access
    // ========================================
    arr[0] = 1;
    arr[a] = b;
    arr[a + 1] = arr[a] + 1;
    c = arr[arr[0]];    // Nested array access

    // ========================================
    // Member access
    // ========================================
    pt.x = 1.0;
    pt.y = 2.0;
    x = pt.x + pt.y;

    // ========================================
    // Procedure call as expression
    // ========================================
    c = Add(a, b);
    c = Add(Add(1, 2), Add(3, 4));      // Nested calls
}

// Procedure with all primitive types as parameters
fn export AllTypes(
    intVal: i64,
    floatVal: f64,
    boolVal: bool,
    charVal: char,
    byteVal: byte
) -> i64
var result: i64;
{
    if boolVal {
        result = intVal;
    } else {
        result = 0;
    }
    return result;
}

// Recursive procedure
// Note: In Obould, return must be at the END of procedure body only
fn export Factorial(n: i64) -> i64
var result: i64;
{
    if n <= 1 {
        result = 1;
    } else {
        result = n * Factorial(n - 1);
    }
    return result;
}

// Procedure with pointer operations
fn export TestPointers(p: IntBoxPtr) -> void
var {
    local: i64;
    localPtr: IntBoxPtr;
    box: IntBox;
}
{
    box.value = 0;
    *p = box;
    local = p.value;
    p.value = local + 1;
    localPtr = nil;
}

// Type guard + IS operator
fn export TestTypeGuards(p: *Point2D) -> f64
var z: f64;
{
    if p is Point3D {
        z = p(Point3D).z;
    } else {
        z = 0.0;
    }
    return z;
}

// Procedure returning struct field
fn export GetX(p: Point2D) -> f64
{
    return p.x;
}

// Main entry point demonstrating various features
fn export Main() -> void
var {
    i: i64;
    x: f64;
    flag: bool;
    p1, p2: Point2D;
    result: f64;
}
{
    // Initialize
    Init();

    // Test arithmetic
    i = Add(10, 20);
    i = Factorial(5);

    // Test struct operations
    p1.x = 0.0;
    p1.y = 0.0;
    p2.x = 3.0;
    p2.y = 4.0;
    result = Distance(p1, p2);

    // Test control flow
    TestStatements();
    TestExpressions();

    /*
     * Multi-line comment
     * This is the end of the main procedure
     */
}
