module OpsAddition


const {
    IntA = 1;
    IntB = 100;

    RealA = 1.5;
    RealB = -2.25;

    SetA = {0, 3..7, 20..30, 63};
    SetB = {0, 1, 5..9, 15..25, 56..59};
}

type {
    IntArr: i64[10];
    RealArr: f64[10];
    ByteArr: byte[10];
    SetArr: set[10];
}

var {
    GInt: i64;
    GReal: f64;
    GByte: byte;
    GSet: set;
    iArr: IntArr;
    fArr: RealArr;
    bArr: ByteArr;
    sArr: SetArr;
}

fn init() -> void
var {
    LIntA, LIntB: i64;
    LRealA, LRealB: f64;
    LByteA, LByteB: byte;
    LSetA, LSetB: set;
}
{
    assert(IntA + IntB == 101);
    assert(IntA + 2 * IntB == 201);
    assert(50 + 30 == 80);
    assert(15 + 20 * 2 + 30 == 85);
    assert(-100 + 100 == 0);

    iArr[0] = 50; iArr[1] = 34;
    LIntA = 67; LIntB = 68;
    GInt = 23;
    bArr[0] = 25; bArr[1] = 17;
    LByteA = 3; LByteB = 7;
    GByte = 46;

    assert(iArr[0] + iArr[1] == 84);
    assert(LIntA + LIntB == 135);
    assert(GInt + LIntA + LIntB + iArr[0] + iArr[1] == 242);

    assert(bArr[0] + bArr[1] == 42);
    assert(LByteA + LByteB == 10);
    assert(GByte + LByteA + LByteB + bArr[0] + bArr[1] == 98);

    assert(iArr[0] + bArr[1] == 67);
    assert(GInt + GByte == 69);
    assert(LByteA + LIntB == 71);

    fArr[0] = 3.25; fArr[1] = 4.0;
    LRealA = 0.5; LRealB = 3.5;
    GReal = -7.75;

    assert(RealA + RealB == -0.75);
    assert(RealA + 2.0 * RealB == -3.0);
    assert(50.0 + 30.0 == 80.0);
    assert(15.0 + 20.0 * 2.0 + 30.0 == 85.0);
    assert(-100.0 + 100.0 == 0.0);

    assert(fArr[0] + fArr[1] == 7.25);
    assert(LRealA + LRealB == 4.0);
    assert(GReal + LRealA + LRealB + fArr[0] + fArr[1] == 3.5);

    sArr[0] = {5}; sArr[1] = {5, 6};
    LSetA = {3}; LSetB = {4};
    GSet = {1, 2, 6, 7, 10..12};
    assert(1 in {0, 2} + {1});
    assert(4 in SetA + SetB);
    assert(5 in sArr[0] + sArr[1]);
    assert(4 in LSetA + LSetB);
    assert(5 in sArr[0] + sArr[1] + GSet + LSetA + LSetB);
}
