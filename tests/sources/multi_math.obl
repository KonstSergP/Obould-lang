module MultiMath

const {
    DEFAULT_BASE = 10;
}

var base: i64;

fn export Add(a, b: i64) -> i64
{
    return a + b;
}

fn export Square(x: i64) -> i64
{
    return x * x;
}

fn export GetDefaultBase() -> i64
{
    return base;
}

fn export Run() -> i64
var tmp: i64;
{
    tmp = Add(base, 5);
    return Square(tmp);
}

fn export init() -> void
{
    base = DEFAULT_BASE;
}