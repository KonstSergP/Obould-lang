module Test

import Out;

var {
    a: i64;
    b: i64;
    res: i64;
}

fn Compute(x: i64) -> i64
{
    return x * x + 3 * x - 7;
}

fn export Run() -> i64
var t: i64;
{
    a = 12;
    b = 5;
    t = Compute(a) + Compute(b);
    res = t + 10;
    Out.WriteInt(res);
    Out.WriteLn();
    return res;
}

fn init() -> void
{
    res = Run();
}
